# Reference only: the app does not load .env files.
# Configure providers in Parvathi > Settings. Store secrets through the Keychain field.
PARVATHI_AI_PROVIDER=openai
PARVATHI_AI_BASE_URL=https://api.openai.com/v1
PARVATHI_AI_MODEL=gpt-6-astra
# OPENAI_API_KEY=<enter in Settings; never commit a real key>
# For a local provider, choose Ollama, use http://localhost:11434 and an installed model.
# Dictation and command mode use Apple Speech and do not require an AI API key.
