<Application x:Class="Parvathi.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F1419"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#182028"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EEF3F5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#61DFE5"/>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#273642"/><Setter Property="Foreground" Value="#EEF3F5"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="BorderBrush" Value="#3A505E"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#345363"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#61DFE5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#17232C"/><Setter Property="Foreground" Value="#EEF3F5"/><Setter Property="CaretBrush" Value="#61DFE5"/><Setter Property="BorderBrush" Value="#435563"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#17232C"/><Setter Property="Foreground" Value="#EEF3F5"/><Setter Property="CaretBrush" Value="#61DFE5"/><Setter Property="BorderBrush" Value="#435563"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF3F5"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111A20"/><Setter Property="Background" Value="#D9E8EF"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#EEF3F5"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/><Setter Property="Background" Value="#263641"/><Setter Property="Foreground" Value="#EAF2F6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7,7,0,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3F6374"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#61DFE5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  </Application.Resources>
</Application>
